general {
    colors = true
    interval = 5
    color_good      = "#9ae17b"
    color_degraded  = "#e0af68"
    color_bad       = "#f7768e"
}

order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "tztime local"

wireless _first_ {
    format_up = "W: (%quality at %essid)"
    format_down = "W: down"
}

ethernet _first_ {
    format_up = "E: up"
    format_down = "E: down"
}

battery all {
    format = "%status %percentage"
}

tztime local {
    format = "%Y-%m-%d %H:%M"
}
