general {
        colors = true
        interval = 5
#	color_good      = "#A3BE8C" # Green
	color_good      = "#81A1C1" # Blue
    	color_degraded  = "#EBCB8B" # Yellow
    	color_bad       = "#BF616A" # Red
}

order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "tztime local"

wireless _first_ {
        format_up = "W: (%quality at %essid)"
        format_down = "W: down"
}

ethernet _first_ {
        format_up = "E: up"
        format_down = "E: down"
}

battery all {
        format = "%status %percentage"
}

tztime local {
        format = "%Y-%m-%d %H:%M"
}
